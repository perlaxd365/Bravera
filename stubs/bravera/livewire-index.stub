<?php

namespace App\Modules\{{module}}\Livewire;

use Livewire\Component;
use Livewire\WithPagination;
use App\Models\{{module}};
use App\Modules\{{module}}\Forms\{{module}}Form;
use App\Modules\{{module}}\Services\{{module}}Service;
use App\Modules\{{module}}\Repositories\{{module}}RepositoryInterface;

class {{module}}Index extends Component
{
    use WithPagination;

    public {{module}}Form $form;

    public bool $showModal = false;

    public ?{{module}} $editing = null;

    public string $search = '';

    public int $perPage = 10;

    public function boot(
        {{module}}RepositoryInterface $repository,
        {{module}}Service $service
    ): void
    {
        $this->repository = $repository;

        $this->service = $service;
    }

    public function create(): void
    {
        $this->resetForm();

        $this->showModal = true;
    }

    public function edit({{module}} $model): void
    {
        $this->editing = $model;

        $this->form->fill(
            $model->toArray()
        );

        $this->showModal = true;
    }

    public function save(): void
    {
        $this->validate();

        if ($this->editing) {

            $this->service->update(
                $this->editing,
                $this->form->toDTO()
            );

        } else {

            $this->service->create(
                $this->form->toDTO()
            );

        }

        $this->closeModal();
    }

    public function delete({{module}} $model): void
    {
        $this->service->delete($model);
    }

    public function closeModal(): void
    {
        $this->showModal = false;

        $this->resetForm();
    }

    protected function resetForm(): void
    {
        $this->editing = null;

        $this->form->reset();
    }

    public function render()
    {
        return view(
            'modules.{{lower}}.views.index',
            [

                '{{plural}}' => $this->repository
                    ->paginate(
                        $this->search,
                        $this->perPage
                    )

            ]
        );
    }
}